# Playwright Automation Configuration

# Required: Login credentials
LOGIN_URL=https://uniepool.easyflex2go.nl/login
SCRAPER_USERNAME=
PASSWORD=

# Optional: Role selection on login page
LOGIN_ROLE=Relatie

# Planning URL settings
USE_PLANNING_CURRENT_WEEK=true
PLANNING_URL_BASE=https://uniepool.easyflex2go.nl/planning/assigner

# When true (default), also export/download next week's planning after the current week
EXPORT_NEXT_WEEK=true

# Download behavior
DOWNLOAD_PAGE_URL=
WAIT_AFTER_LOGIN_MS=3000
EXPORT_PROFILE_LABEL=def export planning chauffeur
EXPORT_PROFILE_APPLY_DELAY_MS=2500

# Debugging
HEADLESS=false
WAIT_FOR_MANUAL_CONFIRM=false
